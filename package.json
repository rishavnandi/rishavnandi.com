    "rehype-slug": "6.0.0",
    "rehype-urls": "1.2.0",
    "shiki": "4.4.2",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
